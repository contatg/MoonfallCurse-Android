if(NOT NRI_SOURCE_DIR)
    message(FATAL_ERROR "NRI_SOURCE_DIR is required")
endif()
set(path "${NRI_SOURCE_DIR}/CMakeLists.txt")
file(READ "${path}" source)
set(old "if(NOT (WIN32 OR CMAKE_SYSTEM_NAME STREQUAL \"Linux\" OR APPLE))")
set(new "if(NOT (WIN32 OR CMAKE_SYSTEM_NAME STREQUAL \"Linux\" OR APPLE OR ANDROID))")
string(FIND "${source}" "${new}" patched)
if(patched EQUAL -1)
    string(FIND "${source}" "${old}" location)
    if(location EQUAL -1)
        message(FATAL_ERROR "Pinned NRI platform check changed; review the Android patch")
    endif()
    string(REPLACE "${old}" "${new}" source "${source}")
    file(WRITE "${path}" "${source}")
endif()

# Wrapped handles must use the same loader even during adapter identification,
# which runs before DeviceVK loads the descriptor's libraryPath.
set(path "${NRI_SOURCE_DIR}/Source/Creation/Creation.cpp")
file(READ "${path}" source)
set(old_signature "VkPhysicalDevice precreatedPhysicalDevice) {")
set(new_signature "VkPhysicalDevice precreatedPhysicalDevice, const char* libraryPath = nullptr) {")
set(old_load "Library* loader = LoadSharedLibrary(NRI_VULKAN_LOADER_NAME);")
set(new_load "Library* loader = LoadSharedLibrary(libraryPath ? libraryPath : NRI_VULKAN_LOADER_NAME);")
set(old_call "UpdateAdaptersVK(&adapterDesc, unused, (VkPhysicalDevice)deviceCreationVKDesc.vkPhysicalDevice);")
set(new_call "UpdateAdaptersVK(&adapterDesc, unused, (VkPhysicalDevice)deviceCreationVKDesc.vkPhysicalDevice, deviceCreationVKDesc.libraryPath);")
string(FIND "${source}" "${new_signature}" patched)
if(patched EQUAL -1)
    foreach(part signature load call)
        string(FIND "${source}" "${old_${part}}" location)
        if(location EQUAL -1)
            message(FATAL_ERROR "Pinned NRI adapter ${part} changed; review the loader patch")
        endif()
        string(REPLACE "${old_${part}}" "${new_${part}}" source "${source}")
    endforeach()
    file(WRITE "${path}" "${source}")
endif()
